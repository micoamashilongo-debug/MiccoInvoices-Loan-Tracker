<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102746">
  <meta name="description" content="MiccoInvoices Loan Tracker helps micro-lenders organize customer records, loans, repayments and outstanding balances.">
  <title>MiccoInvoices Loan Tracker | Manage Loans with Confidence</title>
  <style>
    :root{--navy:#102746;--navy2:#173b68;--blue:#2563eb;--ink:#142238;--muted:#637083;--bg:#f5f8fc;--line:#e2e8f0;--white:#fff;--green:#0f9f6e}
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--ink);background:var(--white);line-height:1.6}
    a{color:inherit} .wrap{width:min(1120px,92%);margin:auto}
    header{background:var(--navy);color:#fff;position:sticky;top:0;z-index:10;border-bottom:1px solid #ffffff20}
    .nav{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:76px}
    .brand{font-weight:800;letter-spacing:.2px;text-decoration:none;font-size:1.05rem}.brand span{color:#8db8ff}
    nav{display:flex;gap:24px;align-items:center}nav a{text-decoration:none;color:#e5edf8;font-size:.94rem}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 19px;border-radius:10px;background:var(--blue);color:#fff;text-decoration:none;border:0;font-weight:750;cursor:pointer;font-size:.96rem}
    .btn:hover{filter:brightness(1.07)}.btn.secondary{background:#fff;color:var(--navy)}.btn.outline{background:transparent;border:1px solid #b8c8df;color:var(--navy)}
    .hero{background:linear-gradient(135deg,var(--navy),#173b68 68%,#20528c);color:#fff;padding:78px 0 74px}
    .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:50px;align-items:center}
    .eyebrow{font-size:.82rem;text-transform:uppercase;letter-spacing:1.6px;color:#b8d3ff;font-weight:800}
    h1{font-size:clamp(2.35rem,5vw,4rem);line-height:1.08;letter-spacing:-1.5px;margin:14px 0 20px}
    .hero p{font-size:1.1rem;color:#e0e9f7;max-width:620px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
    .note{font-size:.86rem!important;color:#c6d6ea!important;margin-top:18px}
    .dashboard{background:#fff;border-radius:18px;padding:20px;box-shadow:0 25px 65px #06172d66;color:var(--ink);transform:rotate(1deg)}
    .dash-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:15px;font-weight:800}
    .pill{font-size:.74rem;background:#dcfce7;color:#166534;padding:5px 9px;border-radius:999px}
    .stats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:16px 0}
    .stat{padding:14px;background:var(--bg);border-radius:12px}.stat small{display:block;color:var(--muted)}.stat strong{font-size:1.3rem}
    .fake-row{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding:12px 3px;font-size:.88rem}.fake-row span:last-child{color:var(--green);font-weight:750}
    section{padding:72px 0} .section-head{text-align:center;max-width:720px;margin:0 auto 36px}.section-head h2{font-size:clamp(1.8rem,3vw,2.5rem);line-height:1.2;margin:0 0 12px;color:var(--navy)}.section-head p{color:var(--muted);margin:0}
    .features{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.feature{border:1px solid var(--line);padding:24px;border-radius:16px;background:#fff}.feature .ico{font-size:1.5rem;background:#eaf1ff;width:48px;height:48px;border-radius:12px;display:grid;place-items:center}.feature h3{margin:16px 0 8px}.feature p{color:var(--muted);margin:0;font-size:.96rem}
    .steps{background:var(--bg)}.step-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.step{background:#fff;padding:22px;border-radius:14px;border:1px solid var(--line)}.number{display:grid;place-items:center;background:var(--navy);color:#fff;width:36px;height:36px;border-radius:50%;font-weight:800}
    .price-card{max-width:560px;margin:auto;border:1px solid var(--line);border-radius:20px;padding:34px;box-shadow:0 15px 40px #1027460c}.price-card h3{margin:0}.price{font-size:3rem;font-weight:850;letter-spacing:-1px;color:var(--navy);margin:10px 0 0}.price small{font-size:1rem;color:var(--muted);font-weight:600;letter-spacing:0}.checks{list-style:none;padding:0;margin:24px 0}.checks li{padding:7px 0}.checks li:before{content:"✓";color:var(--green);font-weight:900;margin-right:10px}
    .trial{background:var(--bg)}.trial-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:40px;align-items:start}.trial-copy h2{font-size:2.3rem;line-height:1.15;color:var(--navy);margin-top:0}.trial-copy p{color:var(--muted)}form{background:#fff;border:1px solid var(--line);padding:26px;border-radius:16px}.field{margin-bottom:16px}label{display:block;font-weight:700;font-size:.9rem;margin-bottom:6px}input,textarea,select{width:100%;padding:12px 13px;border:1px solid #cbd5e1;border-radius:9px;font:inherit;background:#fff}textarea{min-height:110px;resize:vertical}.small{font-size:.82rem;color:var(--muted)}
    .faq{max-width:800px;margin:auto}.faq details{border-bottom:1px solid var(--line);padding:17px 0}.faq summary{font-weight:750;cursor:pointer}.faq p{color:var(--muted)}
    footer{background:#0b1c32;color:#dbe6f5;padding:32px 0}.foot{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.foot small{color:#aebed2}
    .notice{margin-top:16px;padding:12px 14px;border-radius:10px;background:#fff7ed;color:#9a3412;font-size:.9rem;display:none}
    @media(max-width:780px){nav{gap:12px}nav a:not(.btn){display:none}.hero-grid,.trial-grid{grid-template-columns:1fr}.hero{padding:56px 0}.dashboard{transform:none}.features,.step-grid{grid-template-columns:1fr}.trial-copy h2{font-size:2rem}section{padding:54px 0}}
  </style>
</head>
<body>
<header>
  <div class="wrap nav">
    <a class="brand" href="#home">MiccoInvoices <span>Loan Tracker</span></a>
    <nav aria-label="Main navigation">
      <a href="#features">Features</a><a href="#how">How it works</a><a href="#pricing">Pricing</a>
      <a class="btn secondary" href="#trial">Free trial</a>
    </nav>
  </div>
</header>

<main>
  <section class="hero" id="home">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">Simple loan record keeping</div>
        <h1>Spend less time searching for loan records.</h1>
        <p>MiccoInvoices Loan Tracker helps micro-lenders keep customer details, loan amounts, repayments and outstanding balances organized in one place — without relying on loose papers or complicated spreadsheets.</p>
        <div class="actions">
          <a class="btn secondary" href="#trial">Request a free trial</a>
          <a class="btn" href="#demo">Explore the demo</a>
        </div>
        <p class="note">Designed for independent lenders and small lending businesses. Keep your records organized and easier to review.</p>
      </div>
      <div class="dashboard" aria-label="Illustrative loan tracker dashboard">
        <div class="dash-top"><span>Loan overview</span><span class="pill">Illustration</span></div>
        <div class="stats">
          <div class="stat"><small>Total lent</small><strong>N$ 12,500</strong></div>
          <div class="stat"><small>Collected</small><strong>N$ 7,000</strong></div>
          <div class="stat"><small>Outstanding</small><strong>N$ 5,500</strong></div>
          <div class="stat"><small>Active loans</small><strong>8</strong></div>
        </div>
        <div class="fake-row"><span>Customer A · Repayment</span><span>Recorded</span></div>
        <div class="fake-row"><span>Customer B · Due soon</span><span>Reminder</span></div>
        <p class="small">Illustrative figures only — not live customer data.</p>
      </div>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <div class="section-head"><h2>Your lending records, more organized</h2><p>Practical tools to help you track the day-to-day details of your lending business.</p></div>
      <div class="features">
        <article class="feature"><div class="ico">👥</div><h3>Customer records</h3><p>Keep customer names and contact details together with their loan records.</p></article>
        <article class="feature"><div class="ico">💰</div><h3>Loans and balances</h3><p>Record loans, due dates, interest where applicable, repayments and remaining balances.</p></article>
        <article class="feature"><div class="ico">📅</div><h3>Due-date tracking</h3><p>Review loans that are due soon or overdue so you can follow up with customers.</p></article>
        <article class="feature"><div class="ico">🧾</div><h3>Payment history</h3><p>Keep repayment entries to help you review what has been collected.</p></article>
        <article class="feature"><div class="ico">📄</div><h3>Loan records</h3><p>Organize information so it is easier to check records when you need them.</p></article>
        <article class="feature"><div class="ico">🧮</div><h3>Made for everyday use</h3><p>A straightforward workflow for adding a customer, recording a loan and recording a payment.</p></article>
      </div>
    </div>
  </section>

  <section class="steps" id="how">
    <div class="wrap">
      <div class="section-head"><h2>Easy to follow</h2><p>A simple workflow for common loan-tracking tasks.</p></div>
      <div class="step-grid">
        <article class="step"><div class="number">1</div><h3>Add a customer</h3><p>Enter the borrower's details so you can find the record again.</p></article>
        <article class="step"><div class="number">2</div><h3>Add a loan</h3><p>Enter the loan amount, dates and applicable terms.</p></article>
        <article class="step"><div class="number">3</div><h3>Record a payment</h3><p>Enter repayments as the customer pays and review the remaining balance.</p></article>
      </div>
    </div>
  </section>

  <section id="demo">
    <div class="wrap">
      <div class="section-head"><h2>See how it works</h2><p>Explore a demonstration or request a trial account before purchasing.</p></div>
      <div class="price-card">
        <h3>Explore MiccoInvoices Loan Tracker</h3>
        <p>Use the demo to see the application workflow. Do not enter real borrowers' personal information or financial records into a public demonstration.</p>
        <div class="actions">
          <a class="btn" id="demoLink" href="https://helpful-chaja-261276.netlify.app/" target="_blank" rel="noopener noreferrer">Open demo app ↗</a>
          <a class="btn outline" href="#trial">Request my own trial</a>
        </div>
        <p class="small">The demo address is configurable in this file. Confirm it is the correct demo and contains no private customer records before publishing.</p>
      </div>
    </div>
  </section>

  <section id="pricing" class="steps">
    <div class="wrap">
      <div class="section-head"><h2>Simple annual licence</h2><p>One clear price for access to the loan tracker.</p></div>
      <div class="price-card">
        <h3>MiccoInvoices Loan Tracker</h3>
        <div class="price">N$800 <small>/ year</small></div>
        <p>Annual licence — renew every 12 months.</p>
        <ul class="checks">
          <li>Loan and customer record management</li>
          <li>Repayment and outstanding-balance tracking</li>
          <li>Due-date and overdue review</li>
          <li>Account activation by the app owner</li>
        </ul>
        <a class="btn" href="#buy" id="buyButton">Buy Now</a>
        <div class="notice" id="paymentNotice" role="status">Online checkout is not connected yet. Please request a free trial or contact the app owner while the payment provider is being set up.</div>
        <p class="small">Online checkout must be connected to an approved payment provider before accepting payments. Licence terms and account activation should be confirmed before purchase.</p>
      </div>
    </div>
  </section>

  <section class="trial" id="trial">
    <div class="wrap trial-grid">
      <div class="trial-copy">
        <div class="eyebrow" style="color:#2563eb">Get started</div>
        <h2>Request your free trial</h2>
        <p>Send a request and the MiccoInvoices team can contact you to discuss access and help you get started.</p>
        <p><strong>Tip:</strong> Use this form for your business contact details only. Do not send borrower information or sensitive financial records.</p>
      </div>
      <form name="trial-request" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="trial-request">
        <p hidden><label>Do not fill this out: <input name="bot-field"></label></p>
        <div class="field"><label for="name">Your name *</label><input id="name" name="name" autocomplete="name" required></div>
        <div class="field"><label for="business">Business name (optional)</label><input id="business" name="business" autocomplete="organization"></div>
        <div class="field"><label for="email">Email address *</label><input id="email" name="email" type="email" autocomplete="email" required></div>
        <div class="field"><label for="phone">Phone / WhatsApp number</label><input id="phone" name="phone" autocomplete="tel"></div>
        <div class="field"><label for="message">What would you like to know?</label><textarea id="message" name="message" placeholder="For example: I would like a free trial."></textarea></div>
        <button class="btn" type="submit">Send trial request</button>
        <p class="small">After deployment, enable form detection in Netlify and check the Forms section to see submissions.</p>
      </form>
    </div>
  </section>

  <section>
    <div class="wrap faq">
      <div class="section-head"><h2>Frequently asked questions</h2></div>
      <details><summary>Do I need to use Excel?</summary><p>The app is intended to help you keep loan records in one application rather than depending only on handwritten notes or spreadsheets.</p></details>
      <details><summary>Can I try it before paying?</summary><p>Yes. Use the demo link or submit the free-trial request form to discuss trial access.</p></details>
      <details><summary>How do I get my own account?</summary><p>Request a trial or purchase the annual licence. Account access is arranged by the app owner. Automated payment and activation need to be configured separately.</p></details>
      <details><summary>Is online payment available now?</summary><p>The website layout includes a Buy Now section, but the checkout is intentionally not activated until the owner connects an approved payment provider. Do not advertise the checkout as live before testing it.</p></details>
    </div>
  </section>
</main>

<footer>
  <div class="wrap foot">
    <div><strong>MiccoInvoices Loan Tracker</strong><br><small>Simple tools for organized lending records.</small></div>
    <small>© <span id="year"></span> MiccoInvoices. All rights reserved.</small>
  </div>
</footer>
<script>
  document.getElementById("year").textContent = new Date().getFullYear();
  // After your payment provider approves your merchant account, replace the empty
  // string with the official hosted checkout URL supplied by that provider.
  // Do not put private API keys or secret credentials in this public HTML file.
  const PAYMENT_CHECKOUT_URL = "";
  const buyButton = document.getElementById("buyButton");
  const paymentNotice = document.getElementById("paymentNotice");
  buyButton.addEventListener("click", function (event) {
    if (!PAYMENT_CHECKOUT_URL) {
      event.preventDefault();
      paymentNotice.style.display = "block";
      paymentNotice.scrollIntoView({behavior:"smooth", block:"center"});
    } else {
      event.preventDefault();
      window.location.href = PAYMENT_CHECKOUT_URL;
    }
  });
</script>
</body>
</html>

